{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/onaa/schemas/registry-record-0.1.0.json",
  "title": "ONAA registry record - draft, not official A2A AgentCard",
  "type": "object",
  "required": [
    "registry_record_version",
    "id",
    "operator_id",
    "listing_type",
    "display_name",
    "capabilities",
    "status",
    "trust"
  ],
  "properties": {
    "registry_record_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string"
    },
    "operator_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "null only while status is 'discovered' (unclaimed)"
    },
    "listing_type": {
      "enum": [
        "agent",
        "service",
        "hosting"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "agent_card_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "service_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "discovered",
        "claim_pending",
        "registered",
        "endpoint_verified",
        "certified",
        "suspended",
        "deleted"
      ]
    },
    "trust": {
      "type": "object",
      "required": [
        "registration_status",
        "endpoint_control_verified",
        "certifications"
      ],
      "properties": {
        "registration_status": {
          "type": "string"
        },
        "endpoint_control_verified": {
          "type": "boolean"
        },
        "operator_identity_verified": {
          "type": "boolean"
        },
        "legal_entity_verified": {
          "type": "boolean"
        },
        "certifications": {
          "type": "array"
        },
        "registration_method": {
          "enum": [
            "operator_account",
            "agent_self_registration",
            "discovery_import",
            null
          ],
          "description": "How the listing joined. agent_self_registration = the agent proved host control once at signup (anti-abuse gate), not the Endpoint Verified tier."
        }
      }
    },
    "commerce": {
      "type": [
        "object",
        "null"
      ],
      "description": "Self-declared trade terms: pricing, quoting, service_level, capacity, accepts_services, payment_terms, policies, classifications, incoterms"
    },
    "jurisdiction": {
      "type": [
        "object",
        "null"
      ],
      "description": "Self-declared operating_country, excluded_regions, data_residency, compliance_claims, restricted_activities"
    },
    "integration": {
      "type": [
        "object",
        "null"
      ],
      "description": "skills_io schemas, auth_methods, rate limit, status/changelog URLs, depends_on, sunset_at, replaced_by"
    },
    "data_handling": {
      "type": [
        "object",
        "null"
      ],
      "description": "privacy policy, data categories, retention, training use, subprocessors"
    },
    "contacts": {
      "type": [
        "object",
        "null"
      ],
      "description": "support, escalation and security contact URLs"
    },
    "self_reported": {
      "type": [
        "object",
        "null"
      ],
      "description": "Track record claimed by the listing; never ONAA-verified"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension fields (com.example/field, x-name/field); untrusted; max 8 KiB"
    },
    "jwks_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Increments on every change; HTTP ETag W/\"<id>-r<revision>\""
    }
  },
  "additionalProperties": true
}
