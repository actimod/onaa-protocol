{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onaa:schema:v0.1:jws-signature",
  "title": "ONAA Protocol v0.1 detached JWS signature object (DRAFT ONAA profile, not an official A2A/MCP schema)",
  "description": "RFC 7515 JWS with detached payload. Same JSON shape as the A2A 1.0 AgentCardSignature (protected + signature); the unprotected 'header' member is not allowed in ONAA. Payload = RFC 8785 (JCS) canonical JSON of the signed object without its 'signature' member. See specs/onaa-protocol-v0.1.md section 9.",
  "type": "object",
  "required": ["protected", "signature"],
  "properties": {
    "protected": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "BASE64URL(UTF8(JSON protected header)). Header MUST contain alg (EdDSA or Ed25519), kid, typ; MUST NOT contain jku, jwk, x5u, x5c, x5t, crit or b64."
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "BASE64URL of the 64-byte Ed25519 signature."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "protectedHeader": {
      "type": "object",
      "required": ["alg", "kid", "typ"],
      "properties": {
        "alg": { "enum": ["EdDSA", "Ed25519"] },
        "kid": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "typ": { "enum": ["onaa-envelope+jws", "onaa-attestation+jws", "onaa-attestation-status+jws", "onaa-conformance-trigger+jws"] }
      },
      "not": {
        "anyOf": [
          { "required": ["jku"] }, { "required": ["jwk"] }, { "required": ["x5u"] }, { "required": ["x5c"] },
          { "required": ["x5t"] }, { "required": ["x5t#S256"] }, { "required": ["crit"] }, { "required": ["b64"] }
        ]
      }
    },
    "jwks": {
      "description": "RFC 7517 JWK Set served at the agent's jwks_uri. Only public OKP/Ed25519 signing keys are used by ONAA.",
      "type": "object",
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicJwk" }
        }
      }
    },
    "publicJwk": {
      "type": "object",
      "required": ["kty", "kid"],
      "properties": {
        "kty": { "type": "string" },
        "crv": { "type": "string" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "kid": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "use": { "const": "sig" },
        "alg": { "type": "string" }
      },
      "not": { "required": ["d"] },
      "if": { "properties": { "kty": { "const": "OKP" } } },
      "then": { "required": ["crv", "x"] }
    }
  }
}
